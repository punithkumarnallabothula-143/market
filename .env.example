# Database Configuration (Defaults to local SQLite for zero-setup instant local running; easily changed to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Authentication Secret
JWT_SECRET="framemarket-super-secret-jwt-key-change-in-production-32bytes"

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Platform Settings
DEFAULT_CURRENCY="INR"
PLATFORM_COMMISSION_PERCENTAGE="10"

# Payments (Stripe Test Mode - Optional; Demo checkout mode is active when not set)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Razorpay (India Payment Option - Optional)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
